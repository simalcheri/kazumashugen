<!DOCTYPE html>
<html lang="<%= config.language %>">
<%- partial('components/header/head') %>

	<body>
		<%- body %>
			<%- partial('components/scripts') %>
				<% if (theme.plugins.aplayer.enable) { %>
					<%- partial('components/plugins/aplayer') %>
						<% } %>
							<div id="particles-js"
								style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; background: transparent;">
							</div>
							<% if (theme.effects.particles) { %>
								<script>
									document.addEventListener('DOMContentLoaded', function () {
										const mainDiv = document.getElementById("particles-js");
										if (mainDiv) {
											particlesJS("particles-js", {
												"particles": {
													"number": {
														"value": 60,
														"density": {
															"enable": true,
															"value_area": 800
														}
													},
													"color": {
														"value": ["#ffb7c5", "#ff8fab", "#ffc8d8", "#ff6b9d", "#ffccd5"]
													},
													"shape": {
														"type": "image",
														"image": {
															"src": "data:image/svg+xml;base64,",
															"width": 20,
															"height": 20
														}
													},
													"opacity": {
														"value": 0.8,
														"random": true,
														"anim": {
															"enable": true,
															"speed": 0.5,
															"opacity_min": 0.3,
															"sync": false
														}
													},
													"size": {
														"value": 10,
														"random": true,
														"anim": {
															"enable": true,
															"speed": 1,
															"size_min": 5,
															"sync": false
														}
													},
													"line_linked": {
														"enable": false
													},
													"move": {
														"enable": true,
														"speed": 1.5,
														"direction": "bottom",
														"random": true,
														"straight": false,
														"out_mode": "out",
														"bounce": false,
														"attract": {
															"enable": false,
															"rotateX": 600,
															"rotateY": 1200
														}
													}
												},
												"interactivity": {
													"detect_on": "canvas",
													"events": {
														"onhover": {
															"enable": true,
															"mode": "repulse"
														},
														"onclick": {
															"enable": false
														},
														"resize": true
													},
													"modes": {
														"repulse": {
															"distance": 80,
															"duration": 0.4
														}
													}
												},
												"retina_detect": true
											});
										}
									});
								</script>
								<% } %>
	</body>

</html>